<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:macros="sap.fe.macros" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="zwmpickingn.ext.view.Main">
    <macros:Page id="Page" title="WM Picking" showFooter="true">
        <!--This is a sample template, event handlers should be added for implementation-->
        <macros:breadcrumbs>
            <!-- Breadcrumbs aggregation -->
            <Breadcrumbs id="breadcrumbs_breadcrumbs">
                <Link id="breadcrumbs_link" text="Home" press=".onBreadcrumbsPressHome"/>
                <Link id="breadcrumbs_link1" text="Page 1" press=".onBreadcrumbsPressPage1"/>
                <Link id="breadcrumbs_link2" text="Page 2" press=".onBreadcrumbsPressPage2"/>
            </Breadcrumbs>
        </macros:breadcrumbs>
        <macros:navigationActions>
            <!-- Navigation actions aggregation -->
            <Button id="navigationActions_button" icon="sap-icon://full-screen" press=".onNavigationActionsFullScreen1" type="Transparent"/>
        </macros:navigationActions>
        <macros:titleContent>
            <!-- Title content aggregation (content next to title) -->
            <GenericTag id="titleContent_genericTag" text="Status 1" design="StatusIconHidden" status="Information"/>
        </macros:titleContent>
        <macros:actions>
            <!-- Actions aggregation -->
            <Button id="actions_button" text="Action 1" press=".onActionsClickAction1" type="Ghost"/>
            <Button id="actions_button1" text="Action 2" press=".onActionsClickAction2" type="Ghost"/>
        </macros:actions>
        <macros:headerContent>
            <!-- Header content aggregation (content after avatar) -->
            <VBox id="headerContent_vbox">
                <Title id="headerContent_title" text="Page Title 1"/>
            </VBox>
        </macros:headerContent>
        <macros:items>
            <!-- Main content -->
            <IconTabBar id="iconTabBaritems" class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter id="iconTabFilteritems" text="Tab 1">
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </macros:items>
        <macros:footer>
            <!-- Footer aggregation -->
            <OverflowToolbar id="footer_overflowToolbar">
                <ToolbarSpacer id="footer_toolbarSpacer"/>
                <Button id="footer_button" text="Approve" press=".onFooterApprove" type="Accept" icon=""/>
                <Button id="footer_button1" text="Reject" press=".onFooterReject" type="Reject" icon=""/>
            </OverflowToolbar>
        </macros:footer>
    </macros:Page>
</mvc:View>